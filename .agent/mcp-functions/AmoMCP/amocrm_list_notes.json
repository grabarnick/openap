    "properties" : {
      "entity_type" : {
        "type" : "string",
        "description" : "Entity type"
      },
      "entity_id" : {
        "type" : "number",
        "description" : "Entity ID"
      },
      "page" : {
        "type" : "number",
        "description" : "Page number (default: 1)"
      },
      "limit" : {
        "type" : "number",
        "description" : "Results per page, max 250 (default: 50)"
      }
    },
    "required" : [ "entity_type", "entity_id" ]
  }
}